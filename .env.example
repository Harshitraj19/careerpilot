# ---------------------------------------------------------------------------
# CareerPilot configuration. Copy to .env and change the secrets before deploying.
# Never commit your real .env file.
# ---------------------------------------------------------------------------

TZ=Asia/Kolkata

# --- Database / broker ------------------------------------------------------
MYSQL_ROOT_PASSWORD=root-change-me
DB_USER=placify
DB_PASSWORD=placify-change-me
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# --- Security (generate your own!) -------------------------------------------
# JWT signing key, base64 of at least 32 random bytes:  openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktand0LXNlY3JldC1jaGFuZ2UtbWUtcGxhY2lmeS0yMDI2LWtleQ==
# Shared secrets between the gateway and the services (openssl rand -hex 32)
GATEWAY_SECRET=dev-gateway-secret-change-me
INTERNAL_SECRET=dev-internal-secret-change-me
# Minutes of inactivity before a session ends
SESSION_TIMEOUT_MINUTES=15
CAPTCHA_ENABLED=true
# First administrator account (created on first start only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@placify.local
# Show generated temporary passwords in import results (handy in demos; keep false in production)
EXPOSE_TEMP_PASSWORDS=true
# Show e-mail verification codes on screen while MAIL_ENABLED=false (demo only; keep false in production)
EXPOSE_OTP=true
# Let students create their own account (verified by an e-mail code)
STUDENT_SELF_REGISTRATION=true
# Create demo users, jobs, questions and tests on first start
DEMO_DATA=true

# --- Public URLs ---------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8080/ws/notifications
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- AI (Spring AI, OpenAI-compatible API) --------------------------------------
# Google Gemini (free tier available): https://aistudio.google.com/app/apikey
# Leave as is to use CareerPilot's built-in AI engine; set a key for language-model answers
AI_API_KEY=not-configured
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_COMPLETIONS_PATH=/chat/completions
AI_MODEL=gemini-2.5-flash
# Local alternative with Ollama: AI_BASE_URL=http://host.docker.internal:11434  AI_MODEL=llama3.1  AI_COMPLETIONS_PATH=/v1/chat/completions
EMBEDDINGS_ENABLED=true

# --- Code execution ---------------------------------------------------------------
# auto: Judge0 if configured below, otherwise code is compiled and run locally (fine for demos, not sandboxed)
CODE_RUNNER=auto
# Option A: RapidAPI hosted Judge0 CE
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# Option B: self-hosted (docker compose --profile judge0 up -d)
# JUDGE0_URL=http://judge0-server:2358
# JUDGE0_CALLBACK_URL=http://submission-service:8085
JUDGE0_AUTH_TOKEN=

# --- Proctoring ------------------------------------------------------------------
PHONE_DETECTION_ENABLED=true
PROCTORING_FRAME_SECONDS=5

# --- E-mail (OTP, notifications) ---------------------------------------------------
# With MAIL_ENABLED=false e-mails (including OTP codes) are written to the notification/auth logs.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=CareerPilot <no-reply@careerpilot.local>
